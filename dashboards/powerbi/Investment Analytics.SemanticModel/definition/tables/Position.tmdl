	partition Position = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "/data/05_monitoring/allocation_by_holding.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Chosen = Table.SelectColumns(Promoted, {"strategy", "yahoo_symbol", "ticker", "name", "listing_currency", "weight", "sector", "country", "zone", "asset_class", "exposure"}),
				    Typed = Table.TransformColumnTypes(Chosen, {{"strategy", type text}, {"yahoo_symbol", type text}, {"ticker", type text}, {"name", type text}, {"listing_currency", type text}, {"weight", type number}, {"sector", type text}, {"country", type text}, {"zone", type text}, {"asset_class", type text}, {"exposure", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

