		lineageTag: 23e613ea-d406-5ac2-bf74-024f2b0c50c8
		summarizeBy: none
		sourceColumn: sharpe_ratio

	partition Stress = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "/data/08_stress/stress_results.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Chosen = Table.SelectColumns(Promoted, {"strategy", "shock", "months", "window_start", "window_end", "terminal_wealth", "maximum_drawdown", "annualized_volatility", "sharpe_ratio"}),
				    Typed = Table.TransformColumnTypes(Chosen, {{"strategy", type text}, {"shock", type text}, {"months", Int64.Type}, {"window_start", type text}, {"window_end", type text}, {"terminal_wealth", type number}, {"maximum_drawdown", type number}, {"annualized_volatility", type number}, {"sharpe_ratio", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table

