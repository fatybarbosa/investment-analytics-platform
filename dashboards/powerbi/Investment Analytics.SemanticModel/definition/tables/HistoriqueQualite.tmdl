table HistoriqueQualite
	lineageTag: 5b4ba7b5-1800-585f-a8e1-f6905ce2aa48

	measure 'Score du passage' = MAX ( HistoriqueQualite[global_quality_score] )
		formatString: 0.00
		lineageTag: 6f54393f-e42e-5f7f-8b89-e7ba0e24b0b7

	measure 'Score du dernier passage' =
			VAR Dernier =
			    MAX ( HistoriqueQualite[execution_date] )
			RETURN
			    CALCULATE (
			        MAX ( HistoriqueQualite[global_quality_score] ),
			        HistoriqueQualite[execution_date] = Dernier
			    )
		formatString: 0.00
		lineageTag: 8edcf456-a178-5e72-b9d7-07078f7c2bd3

	measure 'Note du dernier passage' =
			VAR Dernier =
			    MAX ( HistoriqueQualite[execution_date] )
			RETURN
			    CALCULATE (
			        MAX ( HistoriqueQualite[global_quality_grade] ),
			        HistoriqueQualite[execution_date] = Dernier
			    )
		lineageTag: c2272440-18bd-533f-8c96-396de793021b

	measure 'Statut du dernier passage' =
			VAR Dernier =
			    MAX ( HistoriqueQualite[execution_date] )
			RETURN
			    CALCULATE (
			        MAX ( HistoriqueQualite[global_status] ),
			        HistoriqueQualite[execution_date] = Dernier
			    )
		lineageTag: 4f878a2f-e83d-5abf-a6cc-d252eb9f6f2b

	column execution_date
		dataType: dateTime
		lineageTag: fa7c43a5-6844-5e55-a2e1-e646e79124f4
		summarizeBy: none
		sourceColumn: execution_date

		variation Variation
			isDefault
			relationship: a92229d2-c659-429e-9552-0fdd0d232ece
			defaultHierarchy: LocalDateTable_b25a1315-7847-4530-a2d2-9114680b3953.'Hiérarchie de dates'

	column records_checked
		dataType: int64
		lineageTag: 356b3a34-f259-508c-b7d6-c2ab03bf5719
		summarizeBy: sum
		sourceColumn: records_checked

		annotation SummarizationSetBy = Automatic

	column datasets_checked
		dataType: int64
		lineageTag: 75a966c7-82c3-57ad-a5cd-7311080dc33d
		summarizeBy: sum
		sourceColumn: datasets_checked

		annotation SummarizationSetBy = Automatic

	column global_quality_score
		dataType: double
		lineageTag: f557dbbc-e875-53ee-9467-6078e66c87e0
		summarizeBy: sum
		sourceColumn: global_quality_score

		annotation SummarizationSetBy = Automatic

	column global_quality_grade
		dataType: string
		lineageTag: 6a44400d-f9f5-5ef6-8f6e-2671a9c0fe12
		summarizeBy: none
		sourceColumn: global_quality_grade

	column global_status
		dataType: string
		lineageTag: b037adb7-8253-5a85-a0ce-a83857774fa1
		summarizeBy: none
		sourceColumn: global_status

	partition HistoriqueQualite = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ProjectRoot & "/audit/data_control_center.xlsx"), null, true),
				    Sheet = Source{[Item = "Quality History", Kind = "Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    Chosen = Table.SelectColumns(Promoted, {"execution_date", "records_checked", "datasets_checked", "global_quality_score", "global_quality_grade", "global_status"}),
				    Typed = Table.TransformColumnTypes(Chosen, {{"execution_date", type datetime}, {"records_checked", Int64.Type}, {"datasets_checked", Int64.Type}, {"global_quality_score", type number}, {"global_quality_grade", type text}, {"global_status", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

