	partition Performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "/data/06_performance/performance_metrics.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Chosen = Table.SelectColumns(Promoted, {"strategy", "months", "window_start", "window_end", "annualized_return", "annualized_volatility", "sharpe_ratio", "sortino_ratio", "maximum_drawdown", "tracking_error", "information_ratio", "months_below_risk_free", "reference"}),
				    Replaced = Table.ReplaceValue(Chosen, "", null, Replacer.ReplaceValue, {"information_ratio"}),
				    Typed = Table.TransformColumnTypes(Replaced, {{"strategy", type text}, {"months", Int64.Type}, {"window_start", type text}, {"window_end", type text}, {"annualized_return", type number}, {"annualized_volatility", type number}, {"sharpe_ratio", type number}, {"sortino_ratio", type number}, {"maximum_drawdown", type number}, {"tracking_error", type number}, {"information_ratio", type number}, {"months_below_risk_free", Int64.Type}, {"reference", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

