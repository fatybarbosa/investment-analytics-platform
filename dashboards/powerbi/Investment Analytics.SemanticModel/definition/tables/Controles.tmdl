	column records_checked
		dataType: int64
		lineageTag: 229f10f0-015e-5cd6-b661-c1393ce16c1d
		summarizeBy: none
		sourceColumn: records_checked

	partition Controles = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ProjectRoot & "/audit/data_control_center.xlsx"), null, true),
				    Sheet = Source{[Item = "Quality Controls", Kind = "Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    Chosen = Table.SelectColumns(Promoted, {"dataset_id", "control_id", "control_name", "status", "issues", "records_checked"}),
				    Typed = Table.TransformColumnTypes(Chosen, {{"dataset_id", type text}, {"control_id", type text}, {"control_name", type text}, {"status", type text}, {"issues", Int64.Type}, {"records_checked", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

