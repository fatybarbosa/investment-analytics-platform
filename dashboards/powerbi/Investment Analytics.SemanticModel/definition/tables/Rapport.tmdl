	partition Rapport = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "/data/05_monitoring/monthly_report.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Chosen = Table.SelectColumns(Promoted, {"strategy", "report_month", "window_start", "window_end", "names", "invested_names", "maximum_weight", "top_10_weight", "hhi", "effective_holdings", "concentration_multiple", "largest_sector", "largest_sector_weight", "largest_zone", "largest_zone_weight", "largest_currency", "largest_currency_weight"}),
				    Typed = Table.TransformColumnTypes(Chosen, {{"strategy", type text}, {"report_month", type text}, {"window_start", type text}, {"window_end", type text}, {"names", Int64.Type}, {"invested_names", Int64.Type}, {"maximum_weight", type number}, {"top_10_weight", type number}, {"hhi", type number}, {"effective_holdings", type number}, {"concentration_multiple", type number}, {"largest_sector", type text}, {"largest_sector_weight", type number}, {"largest_zone", type text}, {"largest_zone_weight", type number}, {"largest_currency", type text}, {"largest_currency_weight", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table

