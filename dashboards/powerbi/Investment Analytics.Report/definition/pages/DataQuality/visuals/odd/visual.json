{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "odd",
  "position": {
    "x": 16,
    "y": 250,
    "z": 4000,
    "height": 440,
    "width": 400,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Odd"
                    }
                  },
                  "Property": "Status"
                }
              },
              "queryRef": "Odd.Status",
              "nativeQueryRef": "Statut",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Odd"
                    }
                  },
                  "Property": "Titres"
                }
              },
              "queryRef": "Odd.Titres",
              "nativeQueryRef": "Titres",
              "active": true
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Statut ODD du registre'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
