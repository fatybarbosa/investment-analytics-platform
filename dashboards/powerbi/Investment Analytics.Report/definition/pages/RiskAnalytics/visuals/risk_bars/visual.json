{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "risk_bars",
  "position": {
    "x": 16,
    "y": 52,
    "z": 2000,
    "height": 280,
    "width": 780,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Strategie"
                    }
                  },
                  "Property": "livre"
                }
              },
              "queryRef": "Strategie.livre",
              "nativeQueryRef": "Livre",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Risque"
                    }
                  },
                  "Property": "Volatilité"
                }
              },
              "queryRef": "Risque.Volatilité",
              "nativeQueryRef": "Volatilité",
              "active": true
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Risque"
                    }
                  },
                  "Property": "VaR"
                }
              },
              "queryRef": "Risque.VaR",
              "nativeQueryRef": "VaR",
              "active": true
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Risque"
                    }
                  },
                  "Property": "Expected shortfall"
                }
              },
              "queryRef": "Risque.Expected shortfall",
              "nativeQueryRef": "Expected shortfall",
              "active": true
            }
          ]
        }
      }
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11D"
                }
              }
            }
          }
        }
      ],
      "zoom": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "showOnCategoryAxis": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "showOnValueAxis": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Queue historique à 95 %'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}